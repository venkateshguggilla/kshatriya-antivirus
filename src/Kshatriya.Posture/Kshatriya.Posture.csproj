<Project Sdk="Microsoft.NET.Sdk">
  <!-- Security posture checks (ADR 0022): the check model and the rules that turn snapshots of system settings
       into results. Pure: no registry, WMI, file or network access; the service and the apps collect the
       snapshots. Shared by the service, the CLI, the desktop app and the Android app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kshatriya.Posture</RootNamespace>
    <!-- Used by the Android app, which is trimmed: keep this library trim-safe. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
</Project>
