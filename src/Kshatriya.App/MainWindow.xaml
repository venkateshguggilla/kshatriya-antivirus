<Window x:Class="Kshatriya.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Kshatriya.App.ViewModels"
        Title="{Binding Title}"
        Width="1180" Height="780" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation. Collapses to an icon rail on narrow windows (see MainWindow.xaml.cs). -->
    <Border x:Name="Nav" Grid.Column="0" Width="{StaticResource NavWidth}"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="8,18,8,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22"
                    AutomationProperties.Name="Kshatriya Antivirus">
          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static vm:Glyphs.Shield}" FontSize="18"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <StackPanel x:Name="Wordmark" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Kshatriya" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Antivirus · prototype" Style="{StaticResource Caption}" />
          </StackPanel>
        </StackPanel>

        <TextBlock x:Name="Footnote" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="14,12,10,0"
                   Text="Runs alongside Microsoft Defender. Keep Defender on." />

        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Current, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 AutomationProperties.Name="Pages" KeyboardNavigation.TabNavigation="Once"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Width="20" TextAlignment="Center" />
                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static vm:Converters.FalseToVisible}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ContentControl x:Name="PageHost" Content="{Binding Current}" Focusable="False"
                      Margin="{StaticResource PagePadding}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
