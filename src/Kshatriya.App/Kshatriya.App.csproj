<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); part of the MIT-licensed .NET desktop pack. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Kshatriya.App</RootNamespace>
    <AssemblyName>Kshatriya.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kshatriya.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF data binding needs culture data; the rest of the solution runs with invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kshatriya.Runtime\Kshatriya.Runtime.csproj" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Keep WPF's Application, MessageBox etc. unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\kshatriya.ico" />
    <Resource Include="Assets\emblem-256.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kshatriya.App.Tests" />
  </ItemGroup>
</Project>
