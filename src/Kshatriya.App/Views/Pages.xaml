<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Page templates, one dictionary per page (ADR 0021). Tokens and shared styles live in Theme.xaml. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Pages/Home.xaml" />
    <ResourceDictionary Source="Pages/Scan.xaml" />
    <ResourceDictionary Source="Pages/Protection.xaml" />
    <ResourceDictionary Source="Pages/History.xaml" />
    <ResourceDictionary Source="Pages/Detections.xaml" />
    <ResourceDictionary Source="Pages/Quarantine.xaml" />
    <ResourceDictionary Source="Pages/AuditLog.xaml" />
    <ResourceDictionary Source="Pages/Updates.xaml" />
    <ResourceDictionary Source="Pages/Settings.xaml" />
    <ResourceDictionary Source="Pages/Exclusions.xaml" />
    <ResourceDictionary Source="Pages/About.xaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
