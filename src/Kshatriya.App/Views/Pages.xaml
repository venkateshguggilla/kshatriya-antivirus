<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kshatriya.App.ViewModels">
  <!-- Page templates. Tokens and shared styles live in Theme.xaml. -->

  <!-- A status icon column for result grids (bound to the row's Tone). -->
  <DataTemplate x:Key="ToneCell">
    <TextBlock Style="{StaticResource ToneGlyph}" Tag="{Binding Tone}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" FontSize="14" />
  </DataTemplate>

  <!-- ===================== Dashboard ===================== -->
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

      <!-- The verdict: one answer to "am I protected?" with the next action next to it. -->
      <Border Style="{StaticResource Banner}" Tag="{Binding VerdictTone}" Margin="0,20,0,0" Padding="20,18">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource ToneGlyph}" Tag="{Binding VerdictTone}" FontSize="28" Margin="0,2,18,0" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="{Binding Verdict}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
            <WrapPanel Margin="0,14,0,0">
              <Button Content="Quick scan" Command="{Binding QuickScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                      AutomationProperties.HelpText="Opens the Scan page and starts a quick scan" />
              <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />

      <TextBlock Text="Protection" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Surface}" Padding="20,4">
        <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Protection checks" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource ListRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" MinWidth="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Secondary}" />
                  <TextBlock Grid.Column="3" Style="{StaticResource ToneGlyph}" Tag="{Binding Tone}" FontSize="14" Margin="12,2,0,0" VerticalAlignment="Top" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Expander Header="Technical details" Margin="0,20,0,0" AutomationProperties.Name="Technical details">
        <StackPanel Margin="4,8,0,0">
          <TextBlock Text="{Binding ServiceState}" Style="{StaticResource Secondary}" />
          <TextBlock Text="{Binding ConnectedAs}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Workers}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding RealTime}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Content}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
          <TextBlock Text="Engines" FontWeight="SemiBold" Margin="0,12,0,4" />
          <TextBlock Text="{Binding Engines}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Button Content="Restart as administrator" Command="{Binding RestartElevatedCommand}" Style="{StaticResource SecondaryButton}"
                  HorizontalAlignment="Left" Margin="0,14,0,0"
                  Visibility="{Binding CanRestartElevated, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.HelpText="Restarts Kshatriya with administrator rights, which restore, exclusions and history require." />
        </StackPanel>
      </Expander>
    </StackPanel>
  </DataTemplate>

  <!-- ===================== Scan ===================== -->
  <Style x:Key="ScanOption" TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
    <Setter Property="GroupName" Value="ScanType" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,10" />
  </Style>

  <DataTemplate DataType="{x:Type vm:ScanViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />

      <TextBlock Text="Choose a scan" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Surface}" Padding="20,6" IsEnabled="{Binding IsScanning, Converter={x:Static vm:Converters.Not}}">
        <StackPanel>
          <RadioButton Style="{StaticResource ScanOption}" IsChecked="{Binding IsQuick}" AutomationProperties.Name="Quick scan">
            <StackPanel>
              <TextBlock Text="Quick scan" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Secondary}" Text="Programs that start with Windows, running programs and services, and your Downloads, Desktop, Temp and Startup folders. Usually takes a few minutes." />
            </StackPanel>
          </RadioButton>
          <Separator />
          <RadioButton Style="{StaticResource ScanOption}" IsChecked="{Binding IsFull}" AutomationProperties.Name="Full scan">
            <StackPanel>
              <TextBlock Text="Full scan" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Secondary}" Text="Every file on every internal drive. Can take hours; it keeps running while the app is in the notification area." />
            </StackPanel>
          </RadioButton>
          <Separator />
          <RadioButton Style="{StaticResource ScanOption}" IsChecked="{Binding IsExternal}" AutomationProperties.Name="External drives scan">
            <StackPanel>
              <TextBlock Text="External drives" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Secondary}" Text="Every connected USB drive, external disk and memory card. New drives are also scanned when you plug them in." />
            </StackPanel>
          </RadioButton>
          <Separator />
          <RadioButton Style="{StaticResource ScanOption}" IsChecked="{Binding IsDrive}" AutomationProperties.Name="Scan one drive">
            <StackPanel>
              <TextBlock Text="One drive" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Secondary}" Text="A single internal or external drive." />
            </StackPanel>
          </RadioButton>
          <!-- Options of a choice sit next to it, not inside the radio button, so each control keeps its own focus and name. -->
          <WrapPanel Margin="28,0,0,12" Visibility="{Binding IsDrive, Converter={StaticResource BoolToVisibility}}">
            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" MinWidth="320" Margin="0,0,8,4"
                      AutomationProperties.Name="Drive to scan" />
            <Button Content="Refresh drives" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" />
          </WrapPanel>
          <Separator />
          <RadioButton Style="{StaticResource ScanOption}" IsChecked="{Binding IsCustom}" AutomationProperties.Name="Custom scan">
            <StackPanel>
              <TextBlock Text="Custom" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Secondary}" Text="Folders you choose." />
            </StackPanel>
          </RadioButton>
          <StackPanel Margin="28,0,0,12" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
              <Button Content="Add folders…" Command="{Binding AddFoldersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
              <Button Content="Downloads" Command="{Binding AddKnownFolderCommand}" CommandParameter="Downloads" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" AutomationProperties.Name="Add Downloads folder" />
              <Button Content="Desktop" Command="{Binding AddKnownFolderCommand}" CommandParameter="Desktop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" AutomationProperties.Name="Add Desktop folder" />
              <Button Content="Documents" Command="{Binding AddKnownFolderCommand}" CommandParameter="Documents" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" AutomationProperties.Name="Add Documents folder" />
            </WrapPanel>
            <TextBlock Text="No folders added yet." Style="{StaticResource Caption}"
                       Visibility="{Binding Targets.Count, Converter={x:Static vm:Converters.ZeroToVisible}}" />
            <ItemsControl ItemsSource="{Binding Targets}" AutomationProperties.Name="Folders to scan">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButton}" Padding="10,3"
                            Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding StringFormat=Remove {0}}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static vm:Glyphs.Folder}" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <CheckBox IsChecked="{Binding Quarantine}" Margin="0,16,0,0" IsEnabled="{Binding IsScanning, Converter={x:Static vm:Converters.Not}}">
        <TextBlock TextWrapping="Wrap" Text="Quarantine confirmed threats (high-confidence malware and test files). Suspicious files are only reported." />
      </CheckBox>
      <WrapPanel Margin="0,16,0,0">
        <Button Content="Scan now" Command="{Binding ScanNowCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,8,0" />
        <Button Content="Cancel scan" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
      </WrapPanel>

      <!-- In progress -->
      <Border Style="{StaticResource Surface}" Margin="0,20,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Scanning…" FontWeight="SemiBold" />
          <ProgressBar Style="{StaticResource LoadingBar}" Margin="0,10,0,10" AutomationProperties.Name="Scan in progress" />
          <TextBlock Text="{Binding Progress}" Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <!-- Result -->
      <Border Style="{StaticResource Banner}" Tag="{Binding SummaryTone}" Margin="0,20,0,0"
              Visibility="{Binding Summary, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource ToneGlyph}" Tag="{Binding SummaryTone}" FontSize="20" Margin="0,1,14,0" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="{Binding SummaryTitle}" FontWeight="SemiBold" FontSize="15" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.LiveSetting="Assertive" />
          </StackPanel>
        </DockPanel>
      </Border>

      <DataGrid ItemsSource="{Binding Results}" Style="{StaticResource ResultGrid}" MaxHeight="440" AutomationProperties.Name="Scan results"
                Visibility="{Binding Results.Count, Converter={x:Static vm:Converters.NonZeroToVisible}}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="36" CellTemplate="{StaticResource ToneCell}" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
          <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="3*" />
          <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DataTemplate>

  <!-- ===================== Detections ===================== -->
  <DataTemplate DataType="{x:Type vm:DetectionsViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Text="Administrators see every finding; other users see findings in their own profile. The list is kept in memory and starts empty when the service restarts." />
      <WrapPanel Margin="0,16,0,0">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
      </WrapPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />

      <Border Style="{StaticResource Surface}" Margin="0,16,0,0" Padding="24,28" Visibility="{Binding Items.Count, Converter={x:Static vm:Converters.ZeroToVisible}}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Style="{StaticResource ToneGlyph}" Tag="{x:Static vm:Tone.Success}" FontSize="28" HorizontalAlignment="Center" />
          <TextBlock Text="No recent detections" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,4" />
          <TextBlock Text="Findings from your scans, scheduled scans and real-time monitoring appear here." Style="{StaticResource Secondary}" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource ResultGrid}" MaxHeight="520" AutomationProperties.Name="Recent detections"
                Visibility="{Binding Items.Count, Converter={x:Static vm:Converters.NonZeroToVisible}}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="36" CellTemplate="{StaticResource ToneCell}" />
          <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal}" Width="140" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
          <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="3*" />
          <DataGridTextColumn Header="Detection" Binding="{Binding Names}" Width="2*" />
          <DataGridTextColumn Header="Found by" Binding="{Binding Source}" Width="*" />
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DataTemplate>

  <!-- ===================== Quarantine ===================== -->
  <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Text="Quarantined files are stored encrypted and cannot run. Restoring needs an administrator and never overwrites an existing file." />
      <WrapPanel Margin="0,16,0,0">
        <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                AutomationProperties.HelpText="Restores the selected file to its original location" />
        <Button Content="Restore to…" Command="{Binding RestoreToCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
        <Button Content="Delete permanently" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                AutomationProperties.HelpText="Deletes the selected item from quarantine. This cannot be undone." />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
      </WrapPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />

      <Border Style="{StaticResource Surface}" Margin="0,8,0,0" Padding="24,28" Visibility="{Binding Items.Count, Converter={x:Static vm:Converters.ZeroToVisible}}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Style="{StaticResource Glyph}" Text="{x:Static vm:Glyphs.Lock}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="Quarantine is empty" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,4" />
          <TextBlock Text="Confirmed threats you choose to quarantine are moved here, encrypted, and can be restored." Style="{StaticResource Secondary}" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource ResultGrid}" SelectionMode="Single" Margin="0,8,0,0"
                MaxHeight="480" AutomationProperties.Name="Quarantined items"
                Visibility="{Binding Items.Count, Converter={x:Static vm:Converters.NonZeroToVisible}}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Quarantined" Binding="{Binding QuarantinedLocal}" Width="140" />
          <DataGridTextColumn Header="Original location" Binding="{Binding OriginalPath}" Width="3*" />
          <DataGridTextColumn Header="Detection" Binding="{Binding Detections}" Width="2*" />
          <DataGridTextColumn Header="For" Binding="{Binding User}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DataTemplate>

  <!-- ===================== Exclusions ===================== -->
  <DataTemplate DataType="{x:Type vm:ExclusionsViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                 Text="Excluded items are still listed as skipped in every report. Changing exclusions needs an administrator. This never changes Microsoft Defender." />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />

      <TextBlock Text="Add an exclusion" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Surface}">
        <StackPanel>
          <TextBlock Text="Full path or SHA-256" FontWeight="SemiBold" Margin="0,0,0,6" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddValueCommand}" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="8,0,0,0" />
            <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Path or SHA-256 to exclude"
                     ToolTip="A full path such as C:\Tools\build, or a SHA-256 value" />
          </DockPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="For example C:\Tools\build, or the 64-character SHA-256 of a file." />
          <Button Content="Choose a folder…" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <DockPanel Margin="0,28,0,0">
        <WrapPanel DockPanel.Dock="Right">
          <Button Content="Remove selected" Command="{Binding RemoveCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
        </WrapPanel>
        <TextBlock Text="Current exclusions" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Text="No exclusions. Kshatriya scans everything it can read." Style="{StaticResource Secondary}" Margin="0,12,0,0"
                 Visibility="{Binding Items.Count, Converter={x:Static vm:Converters.ZeroToVisible}}" />
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource ResultGrid}" SelectionMode="Single"
                MaxHeight="360" AutomationProperties.Name="Exclusions"
                Visibility="{Binding Items.Count, Converter={x:Static vm:Converters.NonZeroToVisible}}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DataTemplate>

  <!-- ===================== History ===================== -->
  <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <Border Style="{StaticResource Banner}" Tag="{Binding ChainTone}" Margin="0,20,0,0"
              Visibility="{Binding ChainState, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource ToneGlyph}" Tag="{Binding ChainTone}" FontSize="18" Margin="0,1,12,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding ChainState}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />
      <WrapPanel Margin="0,16,0,0">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
      </WrapPanel>
      <TextBlock Text="No audit records yet." Style="{StaticResource Secondary}" Margin="0,12,0,0"
                 Visibility="{Binding Records.Count, Converter={x:Static vm:Converters.ZeroToVisible}}" />
      <DataGrid ItemsSource="{Binding Records}" Style="{StaticResource ResultGrid}" MaxHeight="520" AutomationProperties.Name="Audit records"
                Visibility="{Binding Records.Count, Converter={x:Static vm:Converters.NonZeroToVisible}}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="50" />
          <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal}" Width="140" />
          <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" />
          <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110" />
          <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90" />
          <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
          <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DataTemplate>

  <!-- ===================== About ===================== -->
  <DataTemplate DataType="{x:Type vm:AboutViewModel}">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <Border Style="{StaticResource Surface}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
          <TextBlock Text="Open source under the Apache License 2.0." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" />
      <TextBlock Text="Limitations" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Limitations}" Style="{StaticResource Secondary}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
