<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vm="clr-namespace:Kshatriya.App.ViewModels">
  <!--
    Kshatriya design tokens and shared styles. Every colour is a Fluent theme brush, so light, dark and
    high-contrast themes keep working; status colours carry meaning only (success, caution, critical) and
    always come with an icon shape and text. Spacing follows a 4 px grid.
  -->

  <!-- ===== Tokens ===== -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="NavWidth">232</sys:Double>
  <sys:Double x:Key="ContentMaxWidth">1080</sys:Double>
  <Thickness x:Key="PagePadding">32,28,32,32</Thickness>
  <Thickness x:Key="PagePaddingCompact">20,20,20,24</Thickness>
  <CornerRadius x:Key="SurfaceRadius">8</CornerRadius>

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- ===== Typography ===== -->
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
  </Style>

  <Style x:Key="PageLead" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Margin" Value="0,28,0,10" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>

  <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A status icon whose shape and colour follow its Tag (a vm:Tone). -->
  <Style x:Key="ToneGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
    <Setter Property="Text" Value="{x:Static vm:Glyphs.Info}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:Tone.Success}">
        <Setter Property="Text" Value="{x:Static vm:Glyphs.Completed}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:Tone.Caution}">
        <Setter Property="Text" Value="{x:Static vm:Glyphs.Warning}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:Tone.Critical}">
        <Setter Property="Text" Value="{x:Static vm:Glyphs.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style x:Key="Surface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
    <Setter Property="Padding" Value="20,16" />
  </Style>

  <!-- A banner coloured by its Tag (a vm:Tone): used for verdicts, results and messages. -->
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
    <Setter Property="Padding" Value="16,14" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:Tone.Success}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:Tone.Caution}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:Tone.Critical}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Rows of a list inside a surface, separated by hairlines. -->
  <Style x:Key="ListRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,12" />
  </Style>

  <!-- ===== Controls ===== -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Padding" Value="20,7" />
    <Setter Property="MinWidth" Value="112" />
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Padding" Value="16,6" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>

  <!-- Loading bar: animated unless Windows animations are turned off (Settings > Accessibility). -->
  <Style x:Key="LoadingBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="Loading" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False">
        <Setter Property="IsIndeterminate" Value="False" />
        <Setter Property="Value" Value="100" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ResultGrid" TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>

  <!-- Navigation entry: icon and title, with an accent marker on the selected page. -->
  <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
    <Setter Property="ToolTip" Value="{Binding Description}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" MinHeight="40">
            <Grid>
              <Rectangle x:Name="Marker" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
              <ContentPresenter x:Name="Content" Margin="14,0,12,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Icon rail on narrow windows: centre the icon. -->
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter TargetName="Content" Property="Margin" Value="0" />
              <Setter TargetName="Content" Property="HorizontalAlignment" Value="Center" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Problem or information line shared by all pages (bound to PageViewModel.Message / IsError). -->
  <DataTemplate x:Key="MessageLine">
    <Border x:Name="Box" Style="{StaticResource Banner}" Tag="{x:Static vm:Tone.Neutral}" Margin="0,16,0,0"
            Visibility="{Binding Message, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
      <DockPanel>
        <TextBlock x:Name="Icon" DockPanel.Dock="Left" Style="{StaticResource ToneGlyph}" Tag="{x:Static vm:Tone.Neutral}" Margin="0,1,12,0" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsError}" Value="True">
        <Setter TargetName="Box" Property="Tag" Value="{x:Static vm:Tone.Critical}" />
        <Setter TargetName="Icon" Property="Tag" Value="{x:Static vm:Tone.Critical}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Page header: title, lead text and a loading bar while the page refreshes. -->
  <DataTemplate x:Key="PageHeader">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Description}" Style="{StaticResource PageLead}" />
      <ProgressBar Style="{StaticResource LoadingBar}" Margin="0,12,0,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
