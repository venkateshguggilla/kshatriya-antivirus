<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kshatriya.App.ViewModels">
  <!-- Help and about page template. Tokens and shared styles live in Theme.xaml. -->

  <DataTemplate DataType="{x:Type vm:AboutViewModel}">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <Border Style="{StaticResource Surface}" Margin="0,20,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="112" Height="112" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True"
                  AutomationProperties.Name="Kshatriya emblem: an archer drawing a bow">
            <Border.Background>
              <ImageBrush ImageSource="pack://application:,,,/Kshatriya.App;component/Assets/emblem-256.png" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
          <TextBlock Text="Open source under the Apache License 2.0." Style="{StaticResource Secondary}" Margin="0,4,0,0" />
        </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" />
      <TextBlock Text="Limitations" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Limitations}" Style="{StaticResource Secondary}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
