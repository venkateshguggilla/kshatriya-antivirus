<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kshatriya.App.ViewModels">
  <!-- Protection page template (ADR 0021). Tokens and shared styles live in Theme.xaml. -->

  <!-- One protection layer: icon, name and description, state in words, state icon. -->
  <DataTemplate x:Key="ProtectionRowTemplate">
    <Border Style="{StaticResource ListRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" MinWidth="110" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <TextBlock Style="{StaticResource ToneGlyph}" Tag="{Binding Tone}" FontSize="14" Margin="0,2,8,0" />
          <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- One security check (ADR 0022): state icon, title, explanation, and the fix actions it offers. -->
  <DataTemplate x:Key="SecurityCheckTemplate">
    <Border Style="{StaticResource ListRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource ToneGlyph}" Tag="{Binding Tone}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="{Binding Area}" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Fix…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                  Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                  Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=Fix: {0}}" />
          <Button Content="Block…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                  Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                  Visibility="{Binding CanBlock, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=Switch to block: {0}}" />
          <Button Content="Undo…" Style="{StaticResource SecondaryButton}"
                  Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                  Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=Undo the fix: {0}}" />
          <TextBlock Text="{Binding State}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- A USB drive the lock knows (ADR 0023). -->
  <DataTemplate x:Key="LockedDriveTemplate">
    <Border Style="{StaticResource ListRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource ToneGlyph}" Tag="{Binding Tone}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Unlock…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                  Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                  Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="{Binding Name, StringFormat=Unlock {0}}" />
          <TextBlock Text="{Binding State}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ProtectionViewModel}">
    <StackPanel>
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageLine}" Focusable="False" />


      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="Check again" Command="{Binding RunCheckCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" />
        <StackPanel>
          <TextBlock Text="Security check" Style="{StaticResource SectionTitle}" Margin="0" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{Binding CheckSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <Border Style="{StaticResource Surface}" Padding="20,4" Margin="0,10,0,0">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource SecurityCheckTemplate}" AutomationProperties.Name="Security check results" Focusable="False" />
          <CheckBox Content="{Binding ShowAllLabel}" IsChecked="{Binding ShowAllChecks}" Margin="0,12,0,12" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding FixHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

      <TextBlock Text="USB drive lock" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource Surface}">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
              <Button Content="{Binding PasswordButtonLabel}" Command="{Binding SetPasswordCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
              <Button Content="{Binding LockButtonLabel}" Command="{Binding ToggleLockCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
            <StackPanel>
              <TextBlock FontWeight="SemiBold"><Run Text="Lock: " /><Run Text="{Binding LockState, Mode=OneWay}" /></TextBlock>
              <TextBlock Text="{Binding LockDetail}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource LockedDriveTemplate}" AutomationProperties.Name="USB drives" Focusable="False" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="Kshatriya" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource Surface}" Padding="20,4">
        <ItemsControl ItemsSource="{Binding Layers}" ItemTemplate="{StaticResource ProtectionRowTemplate}" AutomationProperties.Name="Kshatriya protection layers" Focusable="False" />
      </Border>
      <TextBlock Text="{Binding ChangeHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

      <TextBlock Text="Browser protection" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource Surface}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Set upâ€¦" Command="{Binding SetUpBrowserExtensionCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="16,0,0,0"
                  AutomationProperties.HelpText="Opens the folder to load in Edge or Chrome with Load unpacked" />
          <TextBlock Style="{StaticResource Secondary}"
                     Text="The Edge and Chrome extension blocks listed sites, sends finished downloads to Kshatriya for a scan and warns about look-alike sites. It sends no web addresses anywhere. You add it to each browser yourself." />
        </DockPanel>
      </Border>

      <DockPanel Margin="0,28,0,0">
        <Button DockPanel.Dock="Right" Content="Open Windows Security" Command="{Binding OpenWindowsSecurityCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" />
        <StackPanel>
          <TextBlock Text="Windows Security" Style="{StaticResource SectionTitle}" Margin="0" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Shown for information. Kshatriya never changes these settings." Style="{StaticResource Caption}" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
      <Border Style="{StaticResource Surface}" Padding="20,4" Margin="0,10,0,0">
        <ItemsControl ItemsSource="{Binding Windows}" ItemTemplate="{StaticResource ProtectionRowTemplate}" AutomationProperties.Name="Windows Security status" Focusable="False" />
      </Border>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
