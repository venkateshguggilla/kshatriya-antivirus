<?xml version="1.0" encoding="utf-8"?>
<!-- Permissions are fixed by ADR 0020: see the list there before adding one. No internet, storage, VPN or
     accessibility permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- See every installed app to scan it (Google Play allows this for antivirus apps). -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <!-- Notify about findings (Android 13 and later ask the user). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Keep the new-apps check scheduled after a restart (persisted job). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <application android:label="Kshatriya" android:icon="@mipmap/appicon" android:allowBackup="false" />
</manifest>
