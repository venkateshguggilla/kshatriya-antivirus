<Window x:Class="Sentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="8">
      <TextBlock DockPanel.Dock="Top" Text="Sentinel" FontSize="22" FontWeight="SemiBold" Margin="8,8,8,2"
                 AutomationProperties.HeadingLevel="Level1" />
      <TextBlock DockPanel.Dock="Top" Text="Prototype · keep Microsoft Defender on" TextWrapping="Wrap"
                 Opacity="0.75" Margin="8,0,8,12" />
      <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Current, Mode=TwoWay}"
               AutomationProperties.Name="Pages" KeyboardNavigation.TabNavigation="Once"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4,6" AutomationProperties.Name="{Binding Title}">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16" Focusable="False">
      <ContentControl Content="{Binding Current}" Focusable="False" />
    </ScrollViewer>
  </Grid>
</Window>
