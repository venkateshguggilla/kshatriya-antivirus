<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Kshatriya.Service</RootNamespace>
    <AssemblyName>Kshatriya.Service</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kshatriya.Runtime\Kshatriya.Runtime.csproj" />
    <ProjectReference Include="..\Kshatriya.Response\Kshatriya.Response.csproj" />
    <ProjectReference Include="..\Kshatriya.Updates\Kshatriya.Updates.csproj" />
    <!-- The service launches the worker from its own directory. -->
    <ProjectReference Include="..\Kshatriya.Worker\Kshatriya.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kshatriya.Service.Tests" />
  </ItemGroup>
</Project>
