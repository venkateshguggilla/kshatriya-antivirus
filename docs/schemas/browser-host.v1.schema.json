{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/venkateshguggilla/kshatriya-antivirus/docs/schemas/browser-host.v1.schema.json",
  "title": "Kshatriya browser host reply, version 1",
  "description": "Replies from the native messaging host com.kshatriya.browser_host to the browser extension (ADR 0018). Requests are {\"v\":1,\"type\":\"status\"} or {\"v\":1,\"type\":\"scan\",\"path\":\"C:\\\\...\"}.",
  "type": "object",
  "required": ["v", "type", "ok"],
  "properties": {
    "v": { "const": 1 },
    "type": { "enum": ["status", "scan", "error"] },
    "ok": { "type": "boolean" },
    "serviceVersion": { "type": "string", "maxLength": 200 },
    "status": { "enum": ["clean", "detected", "suspicious", "skipped", "notScanned"] },
    "reason": { "type": "string", "maxLength": 64 },
    "detections": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "category", "confidence"],
        "properties": {
          "name": { "type": "string", "maxLength": 200 },
          "category": { "enum": ["malware", "pua", "suspicious", "test"] },
          "confidence": { "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "enum": ["invalid-request", "unsupported-version", "invalid-path", "not-a-file", "service-unavailable", "scan-failed"]
    },
    "message": { "type": "string", "maxLength": 200 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error", "message"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "type": { "const": "scan" } } },
      "then": { "required": ["status", "detections"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "type": { "const": "status" } } },
      "then": { "required": ["serviceVersion"] }
    }
  ]
}
