{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kshatriya.invalid/schemas/scan-report.v1.schema.json",
  "title": "Kshatriya scan report",
  "description": "Report produced by 'kshatriya scan --json'. Version 1. New optional properties may be added in minor revisions; removals or meaning changes require a new schemaVersion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "tool", "startedUtc", "finishedUtc", "durationMs", "complete",
    "cleanItemsIncluded", "targets", "engines", "summary", "items"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "Kshatriya" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "startedUtc": { "type": "string", "format": "date-time" },
    "finishedUtc": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "complete": {
      "type": "boolean",
      "description": "False when at least one item has status 'notScanned'."
    },
    "cleanItemsIncluded": {
      "type": "boolean",
      "description": "When false, clean items are counted in 'summary' but omitted from 'items'."
    },
    "targets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "contentVersion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "contentVersion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemsSeen", "filesScanned", "detected", "skipped", "notScanned", "bytesScanned"],
      "properties": {
        "itemsSeen": { "type": "integer", "minimum": 0 },
        "filesScanned": { "type": "integer", "minimum": 0 },
        "detected": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "notScanned": { "type": "integer", "minimum": 0 },
        "bytesScanned": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "status", "detections"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "directory", "stream"] },
        "status": { "enum": ["clean", "detected", "skipped", "notScanned"] },
        "reason": {
          "enum": [
            "reparsePoint", "cloudPlaceholder", "loopDetected", "tooLarge", "timeout",
            "accessDenied", "locked", "notFound", "ioError", "engineError"
          ]
        },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "message": { "type": "string" },
        "detections": {
          "type": "array",
          "items": { "$ref": "#/definitions/detection" }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "name", "category", "confidence"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["malware", "pua", "suspicious", "test"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "description": { "type": "string" }
      }
    }
  }
}
