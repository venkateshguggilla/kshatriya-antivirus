<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release workflow (.github/workflows/release.yml).
  Copy it into the SignPath project as the artifact configuration. The GitHub artifact is the unsigned
  release folder, which SignPath receives as a zip. Only Sentinel's own binaries are signed; the .NET
  runtime files and yara_x_capi.dll keep their upstream signatures (or none) and are never re-signed.
  Product name and version restrictions (Sentinel, one version per release) are set in the signing policy.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Sentinel.*.exe" />
      <include path="Sentinel.*.dll" />
      <include path="sentinel.exe" />
      <include path="sentinel.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
