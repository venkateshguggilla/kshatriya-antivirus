<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Kshatriya.CoverageFuzz</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Development tool only; never shipped. SharpFuzz, SharpFuzz.Common and dnlib are MIT. -->
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kshatriya.Engines.Pe/Kshatriya.Engines.Pe.csproj" />
    <ProjectReference Include="../../src/Kshatriya.Engines.Hash/Kshatriya.Engines.Hash.csproj" />
    <ProjectReference Include="../../src/Kshatriya.Scanning/Kshatriya.Scanning.csproj" />
    <ProjectReference Include="../../src/Kshatriya.Updates/Kshatriya.Updates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../tests/Shared/Mutator.cs" Link="Shared/Mutator.cs" />
    <Compile Include="../../tests/Shared/PeBuilder.cs" Link="Shared/PeBuilder.cs" />
    <Compile Include="../../tests/Shared/ZipFactory.cs" Link="Shared/ZipFactory.cs" />
    <Compile Include="../../tests/Shared/TestData.cs" Link="Shared/TestData.cs" />
  </ItemGroup>
</Project>
