    <ProjectReference Include="../../src/Sentinel.Engines.Hash/Sentinel.Engines.Hash.csproj" />
    <ProjectReference Include="../../src/Sentinel.Scanning/Sentinel.Scanning.csproj" />
    <ProjectReference Include="../../src/Sentinel.Updates/Sentinel.Updates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../tests/Shared/Mutator.cs" Link="Shared/Mutator.cs" />
    <Compile Include="../../tests/Shared/PeBuilder.cs" Link="Shared/PeBuilder.cs" />
    <Compile Include="../../tests/Shared/ZipFactory.cs" Link="Shared/ZipFactory.cs" />
    <Compile Include="../../tests/Shared/TestData.cs" Link="Shared/TestData.cs" />
  </ItemGroup>
</Project>
